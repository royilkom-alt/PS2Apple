+#ifdef DHD_IOS
+static void ios_start_log(void)
+{
+    const char *home = getenv("HOME");
+    char path[PATH_MAX], previous[PATH_MAX];
+    if (!home) return;
+    int n = snprintf(path, sizeof path, "%s/Documents/dhd-startup.log", home);
+    int p = snprintf(previous, sizeof previous, "%s/Documents/dhd-startup-previous.log", home);
+    if (n < 0 || (size_t)n >= sizeof path || p < 0 || (size_t)p >= sizeof previous) return;
+    rename(path, previous);
+    int fd = open(path, O_CREAT | O_WRONLY | O_TRUNC, 0600);
+    if (fd < 0) return;
+    fflush(stdout);
+    fflush(stderr);
+    dup2(fd, STDERR_FILENO);
+    dup2(fd, STDOUT_FILENO);
+    if (fd != STDOUT_FILENO && fd != STDERR_FILENO) close(fd);
+    setvbuf(stdout, NULL, _IONBF, 0);
+    setvbuf(stderr, NULL, _IONBF, 0);
+    fprintf(stderr, "ios: starting native host with explicit guest memory bounds\n");
+}
+#endif
