+static UIColor *DHDColor(unsigned hex, CGFloat alpha)
+{
+    return [UIColor colorWithRed:((hex >> 16) & 255) / 255.0
+                           green:((hex >> 8) & 255) / 255.0
+                            blue:(hex & 255) / 255.0 alpha:alpha];
+}
+
+static UILabel *DHDLabel(NSString *text, CGFloat size, UIFontWeight weight)
+{
+    UILabel *label = [[UILabel alloc] init];
+    label.text = text;
+    label.font = [UIFont systemFontOfSize:size weight:weight];
+    label.textColor = DHDColor(0xEBF3FF, 1);
+    label.numberOfLines = 0;
+    return label;
+}
+
+static BOOL DHDEnabled(NSString *value)
+{
+    return ![@[@"0", @"off", @"false", @"no"] containsObject:value.lowercaseString];
+}
