+- (NSString *)value:(NSString *)key fallback:(NSString *)fallback
+{
+    NSString *value = self.values[key];
+    if (value) return value;
+    char text[1024] = {0};
+    if (dhd_settings_read(self.settingsPath.fileSystemRepresentation, key.UTF8String, text, sizeof text))
+        value = [NSString stringWithUTF8String:text];
+    value = value.length ? value : fallback;
+    if (![key isEqualToString:@"ios_gamepad"]) value = value.lowercaseString;
+    self.values[key] = value;
+    return value;
+}
