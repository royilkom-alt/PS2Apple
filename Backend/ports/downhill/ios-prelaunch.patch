+@interface DHDBackdrop : UIView
+@end
+
+@implementation DHDBackdrop
+- (instancetype)init
+{
+    self = [super init];
+    if (self) {
+        self.backgroundColor = DHDColor(0x020611, 1);
+        self.userInteractionEnabled = NO;
+        CALayer *halo = [CALayer layer];
+        halo.name = @"halo";
+        halo.backgroundColor = DHDColor(0x0578FF, 0.1).CGColor;
+        halo.shadowColor = DHDColor(0x3A92FF, 1).CGColor;
+        halo.shadowOpacity = 0.45;
+        halo.shadowRadius = 65;
+        [self.layer addSublayer:halo];
+        if (!UIAccessibilityIsReduceMotionEnabled()) {
+            CABasicAnimation *breath = [CABasicAnimation animationWithKeyPath:@"opacity"];
+            breath.fromValue = @0.35;
+            breath.toValue = @1;
+            breath.duration = 4;
+            breath.autoreverses = YES;
+            breath.repeatCount = HUGE_VALF;
+            [halo addAnimation:breath forKey:@"breath"];
+        }
+    }
+    return self;
+}
+
+- (void)layoutSubviews
+{
+    [super layoutSubviews];
+    CALayer *halo = self.layer.sublayers.firstObject;
+    CGFloat diameter = self.bounds.size.height * 0.8;
+    halo.frame = CGRectMake(-diameter * 0.2, -diameter * 0.3, diameter, diameter);
+    halo.cornerRadius = diameter / 2;
+    [self setNeedsDisplay];
+}
+
+- (void)drawRect:(CGRect)rect
+{
+    CGContextRef context = UIGraphicsGetCurrentContext();
+    CGFloat width = rect.size.width, height = rect.size.height;
+    for (int i = 0; i < 17; i++) {
+        CGFloat x = width * (i / 17.0);
+        CGFloat towerWidth = MAX(12, width / 35);
+        CGFloat towerHeight = height * (0.14 + ((i * 7) % 11) / 26.0);
+        CGFloat y = height - towerHeight;
+        CGContextSetFillColorWithColor(context, DHDColor(0x123268, 0.20).CGColor);
+        CGContextFillRect(context, CGRectMake(x, y, towerWidth, towerHeight));
+        UIBezierPath *top = [UIBezierPath bezierPath];
+        [top moveToPoint:CGPointMake(x, y)];
+        [top addLineToPoint:CGPointMake(x + towerWidth / 2, y - towerWidth / 3)];
+        [top addLineToPoint:CGPointMake(x + towerWidth * 1.5, y - towerWidth / 3)];
+        [top addLineToPoint:CGPointMake(x + towerWidth, y)];
+        [top closePath];
+        [DHDColor(0x3678CB, 0.22) setFill];
+        [top fill];
+    }
+    for (int i = 0; i < 40; i++) {
+        CGFloat x = width * (((i * 37) % 101) / 101.0);
+        CGFloat y = height * (((i * 19) % 97) / 97.0);
+        CGContextSetFillColorWithColor(context, DHDColor(0x7EB8FF, i % 3 ? 0.13 : 0.35).CGColor);
+        CGContextFillEllipseInRect(context, CGRectMake(x, y, 2, 2));
+    }
+}
+@end
