+/* Standard mobile pad, anchored inside the real safe area. The same controls work before
+   the first race HUD, in the game's menus, while paused, and in a race. */
+static void full_pad_layout(Touch *t)
+{
+    const TouchScreen *sc = &t->screen;
+    float left = sc->strip_left, right = sc->width - sc->strip_right;
+    float top = sc->strip_top, bottom = sc->height - sc->strip_bottom;
+    float s = t->set.size > 0 ? t->set.size / 100.0f : 1.0f;
+    s = fminf(s, fminf((right - left) / 130.0f, (bottom - top) / 55.0f));
+    s = fmaxf(s, 0.35f);
+    t->s = t->bs = s;
+    memset(t->ctl, 0, sizeof t->ctl);
+    struct { int control; float x, y, radius, hw, hh; } places[] = {
+        {TC_DPAD, left + 18*s, bottom - 19*s, 13*s, 0, 0},
+        {TC_STICK, left + 46*s, bottom - 15*s, 11*s, 0, 0},
+        {TC_RSTICK, right - 47*s, bottom - 15*s, 11*s, 0, 0},
+        {TC_L3, left + 46*s, bottom - 33*s, 4*s, 0, 0},
+        {TC_R3, right - 47*s, bottom - 33*s, 4*s, 0, 0},
+        {TC_TRIANGLE, right - 20*s, bottom - 32*s, 4.8f*s, 0, 0},
+        {TC_CSQUARE, right - 30*s, bottom - 22*s, 4.8f*s, 0, 0},
+        {TC_CCIRCLE, right - 10*s, bottom - 22*s, 4.8f*s, 0, 0},
+        {TC_CROSS, right - 20*s, bottom - 12*s, 4.8f*s, 0, 0},
+        {TC_LBAR, left + 21*s, bottom - 48*s, 0, 16*s, 4*s},
+        {TC_RBAR, right - 21*s, bottom - 48*s, 0, 16*s, 4*s},
+        {TC_CAMERA, (left + right)/2 - 10*s, top + 7*s, 0, 8*s, 3.5f*s},
+        {TC_PAUSE, (left + right)/2 + 10*s, top + 7*s, 0, 8*s, 3.5f*s},
+    };
+    for (unsigned i = 0; i < sizeof places / sizeof *places; i++) {
+        Ctl *k = &t->ctl[places[i].control];
+        k->on = 1;
+        k->x = right_handed(t) ? places[i].x : left + right - places[i].x;
+        k->y = places[i].y;
+        k->r = places[i].radius;
+        k->hw = places[i].hw, k->hh = places[i].hh;
+        k->box = k->hw > 0;
+    }
+}
