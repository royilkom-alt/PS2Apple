+static uint16_t dpad_buttons(const Touch *t, float x, float y)
+{
+    const Ctl *k = &t->ctl[TC_DPAD];
+    float dx = (x - k->x) / k->r, dy = (y - k->y) / k->r;
+    uint16_t b = 0;
+    if (dx > 0.28f) b |= PAD_RIGHT;
+    if (dx < -0.28f) b |= PAD_LEFT;
+    if (dy > 0.28f) b |= PAD_DOWN;
+    if (dy < -0.28f) b |= PAD_UP;
+    return b;
+}
+
+static void route_full_pad(Touch *t, Finger *f)
+{
+    static const int controls[] = {TC_DPAD, TC_STICK, TC_RSTICK, TC_CAMERA, TC_PAUSE,
+        TC_LBAR, TC_RBAR, TC_L3, TC_R3, TC_CROSS, TC_TRIANGLE, TC_CSQUARE, TC_CCIRCLE};
+    int c = control_at(t, f->x, f->y, controls, sizeof controls / sizeof *controls);
+    f->control = c;
+    if (c < 0 || in_strip(t, f->x, f->y)) { f->job = JOB_IGNORED; return; }
+    if (c == TC_STICK) {
+        if (t->stick_finger < 0) stick_begins(t, f);
+        else f->job = JOB_IGNORED;
+        return;
+    }
+    if (c == TC_RSTICK) {
+        for (int i = 0; i < TOUCH_FINGERS; i++)
+            if (&t->f[i] != f && t->f[i].used && t->f[i].job == JOB_RSTICK) { f->job = JOB_IGNORED; return; }
+        f->job = JOB_RSTICK;
+        return;
+    }
+    f->job = JOB_BUTTON;
+    switch (c) {
+    case TC_DPAD: f->buttons = dpad_buttons(t, f->x, f->y); break;
+    case TC_CAMERA: f->buttons = PAD_SELECT; break;
+    case TC_PAUSE: f->buttons = PAD_START; break;
+    case TC_L3: f->buttons = PAD_L3; break;
+    case TC_R3: f->buttons = PAD_R3; break;
+    case TC_LBAR: case TC_RBAR: f->buttons = bar_buttons(t, c, f->x); break;
+    case TC_CROSS: f->buttons = PAD_CROSS; break;
+    case TC_TRIANGLE: f->buttons = PAD_TRIANGLE; break;
+    case TC_CSQUARE: f->buttons = PAD_SQUARE; break;
+    case TC_CCIRCLE: f->buttons = PAD_CIRCLE; break;
+    }
+    press_begins(t, f);
+    buzz(t, TOUCH_BUZZ_TICK);
+}
