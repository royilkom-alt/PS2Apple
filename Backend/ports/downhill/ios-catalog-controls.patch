+/* The iOS pad is usable before the race HUD, including the game's title, menus and pause
+   screen. These checks read its actual shapes and PS2 pad output, not just its enable flag. */
+static void test_full_pad(void)
+{
+    const int rates[] = {30, 60, 120};
+    const int controls[] = {TC_CROSS, TC_TRIANGLE, TC_CSQUARE, TC_CCIRCLE, TC_PAUSE, TC_CAMERA, TC_L3, TC_R3};
+    const uint16_t bits[] = {PAD_CROSS, PAD_TRIANGLE, PAD_SQUARE, PAD_CIRCLE, PAD_START, PAD_SELECT, PAD_L3, PAD_R3};
+    TouchShape shapes[TOUCH_SHAPES];
+    for (int hud = 0; hud < 2; hud++)
+        for (unsigned rate = 0; rate < sizeof rates / sizeof *rates; rate++) {
+            start(TOUCH_CLASSIC, TOUCH_ATTACK_FLICK);
+            TouchSettings s = *touch_settings(t);
+            s.full_pad = 1;
+            s.stick_fixed = 1;
+            touch_configure(t, &s, NULL);
+            game.race_hud = hud;
+            game.clock_moving = hud;   /* a stopped race clock must not block menu presses */
+            game.fps = rates[rate];
+            fields(30);
+            CHECK(touch_visible(t) && touch_owns_touches(t));
+            int count = touch_shapes(t, shapes, TOUCH_SHAPES);
+            int symbols[TS_STRIPES + 1] = {0};
+            for (int i = 0; i < count; i++) symbols[shapes[i].kind]++;
+            CHECK(symbols[TS_CROSS] == 1 && symbols[TS_CIRCLE] == 1);
+            CHECK(symbols[TS_TRIANGLE] == 1 && symbols[TS_SQUARE] == 1);
+            CHECK(symbols[TS_CHEVRON] == 2 && symbols[TS_DISC] >= 8);
+            CHECK(touch_hud_mode(t) == 0 && !touch_freeze(t));
+            for (unsigned i = 0; i < sizeof controls / sizeof *controls; i++) {
+                float x, y;
+                at(controls[i], &x, &y);
+                touch_down(t, 100+i, x, y, now);
+                field();
+                CHECK(buttons() == bits[i]);
+                touch_up(t, 100+i, x, y, now);
+                fields(8);
+                CHECK(buttons() == 0);
+            }
+            /* D-pad diagonals and sliding to the opposite direction. */
+            float x, y, r;
+            CHECK(touch_control(t, TC_DPAD, &x, &y, &r));
+            touch_down(t, 20, x-r*0.65f, y-r*0.65f, now);
+            field();
+            CHECK(buttons() == (PAD_UP | PAD_LEFT));
+            touch_move(t, 20, x+r*0.65f, y+r*0.65f, now);
+            field();
+            CHECK(buttons() == (PAD_DOWN | PAD_RIGHT));
+            touch_up(t, 20, x, y, now);
+            fields(8);
+            /* Both sticks plus pedal at once: movement is independent of face buttons. */
+            at(TC_STICK, &x, &y);
+            touch_down(t, 21, x, y, now);
+            touch_move(t, 21, x+8, y-4, now);
+            at(TC_RSTICK, &x, &y);
+            touch_down(t, 22, x, y, now);
+            touch_move(t, 22, x-8, y+4, now);
+            at(TC_CROSS, &x, &y);
+            touch_down(t, 23, x, y, now);
+            field();
+            uint16_t b = 0;
+            uint8_t lx = 128, ly = 128, rx = 128, ry = 128;
+            touch_pad(t, &b, &lx, &ly, &rx, &ry);
+            CHECK((b & PAD_CROSS) && lx > 210 && ly < 90 && rx < 45 && ry > 165);
+            touch_cancel_all(t, now);
+            field();
+            CHECK(buttons() == 0 && stick_x() == 128);
+            /* Each shoulder half maps to one PS2 button; centre holds both. */
+            for (int side = 0; side < 2; side++) {
+                at(side ? TC_RBAR : TC_LBAR, &x, &y);
+                touch_down(t, 24, x-10, y, now);
+                field();
+                CHECK(buttons() == (side ? PAD_R1 : PAD_L2));
+                touch_cancel_all(t, now);
+                touch_down(t, 25, x+10, y, now);
+                field();
+                CHECK(buttons() == (side ? PAD_R2 : PAD_L1));
+                touch_cancel_all(t, now);
+            }
+            /* No invisible pad after a gamepad disconnect, even in menus. */
+            touch_pad_used(t, now);
+            CHECK(!touch_visible(t));
+            touch_pad_lost(t, now);
+            CHECK(touch_visible(t) && touch_shapes(t, shapes, TOUCH_SHAPES) == count);
+            CHECK(!(buttons() & PAD_START));
+            /* A quick tap between reads must reach the game once, then release. */
+            at(TC_CAMERA, &x, &y);
+            touch_down(t, 26, x, y, now);
+            touch_up(t, 26, x, y, now);
+            field();
+            CHECK(buttons() == PAD_SELECT);
+            fields(8);
+            CHECK(buttons() == 0);
+            /* The controls stay on screen as the game switches between menus and race. */
+            game.race_hud = !hud;
+            fields(30);
+            CHECK(touch_visible(t) && touch_shapes(t, shapes, TOUCH_SHAPES) == count);
+        }
+    /* Insets and small screens: each control's centre remains inside the usable area. */
+    const TouchScreen screens[] = {
+        {104, 58, 0, 0, 0, 0, 0, 0, 0, 0},
+        {145, 65, 9, 9, 0, 3, 0, 0, 0, 0},
+        {204, 150, 0, 0, 4, 4, 0, 0, 0, 0},
+    };
+    for (unsigned i = 0; i < sizeof screens / sizeof *screens; i++) {
+        TouchSettings s = *touch_settings(t);
+        s.size = 105;
+        touch_configure(t, &s, &screens[i]);
+        for (int c = 0; c < TC_COUNT; c++) {
+            float x, y, r;
+            if (!touch_control(t, c, &x, &y, &r)) continue;
+            CHECK(x >= screens[i].strip_left && x <= screens[i].width-screens[i].strip_right);
+            CHECK(y >= screens[i].strip_top && y <= screens[i].height-screens[i].strip_bottom);
+        }
+    }
+}
