+static int right_stick(const Touch *t, float *x, float *y, float *cx, float *cy)
+{
+    const Ctl *k = &t->ctl[TC_RSTICK];
+    *x = *y = 0;
+    *cx = k->x, *cy = k->y;
+    for (int i = 0; i < TOUCH_FINGERS; i++) {
+        const Finger *f = &t->f[i];
+        if (!f->used || f->job != JOB_RSTICK) continue;
+        if (!t->set.stick_fixed) *cx = f->x0, *cy = f->y0;
+        float range = k->r * 0.8f;
+        float dx = f->x - *cx, dy = f->y - *cy, length = hypotf(dx, dy);
+        if (length > range) dx *= range / length, dy *= range / length;
+        *x = dx / range, *y = dy / range;
+        return 1;
+    }
+    return 0;
