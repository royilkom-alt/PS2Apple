diff --git a/port/ios/main.m b/port/ios/main.m
new file mode 100644
index 0000000..4d4eb9a
--- /dev/null
+++ b/port/ios/main.m
@@ -0,0 +1,82 @@
+/* iPhoneOS entry for the shared SDL host. The disc is copied by the player through Files.
+   This file is part of the Downhill Revived port and is licensed GPL-3.0-or-later. */
+#import <Foundation/Foundation.h>
+#include <SDL3/SDL.h>
+#include <SDL3/SDL_main.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include "../render/include/dhd_settings.h"
+
+int dhd_launcher_main(int argc, char **argv);
+const char *host_disc_check(const char *path);
+
+static char writable_executable_path[PATH_MAX];
+
+const char *ios_exe_path(void)
+{
+    return writable_executable_path;
+}
+
+static BOOL wait_for_disc(NSString *disc)
+{
+    const char *problem = host_disc_check(disc.fileSystemRepresentation);
+    if (!problem) return YES;
+    if (!SDL_InitSubSystem(SDL_INIT_VIDEO)) {
+        fprintf(stderr, "ios: could not start SDL video: %s\n", SDL_GetError());
+        return NO;
+    }
+    SDL_Window *window = SDL_CreateWindow("Downhill Revived", 640, 360, SDL_WINDOW_FULLSCREEN);
+    if (!window) {
+        fprintf(stderr, "ios: could not open the setup window: %s\n", SDL_GetError());
+        SDL_QuitSubSystem(SDL_INIT_VIDEO);
+        return NO;
+    }
+    while (problem) {
+        NSString *message = [NSString stringWithFormat:
+            @"%s\n\nCopy your Downhill Domination USA ISO to Files → On My iPhone → Downhill Revived. "
+             "Name it SCUS-97177.iso, then return here and tap Check Again.", problem];
+        const SDL_MessageBoxButtonData button = {SDL_MESSAGEBOX_BUTTON_RETURNKEY_DEFAULT, 1, "Check Again"};
+        const SDL_MessageBoxData box = {
+            SDL_MESSAGEBOX_INFORMATION, window, "Downhill Revived", message.UTF8String, 1, &button, NULL
+        };
+        if (!SDL_ShowMessageBox(&box, NULL)) break;
+        problem = host_disc_check(disc.fileSystemRepresentation);
+    }
+    SDL_DestroyWindow(window);
+    SDL_QuitSubSystem(SDL_INIT_VIDEO);
+    return problem == NULL;
+}
+
+int main(int argc, char **argv)
+{
+    @autoreleasepool {
+        NSFileManager *files = [NSFileManager defaultManager];
+        NSURL *support = [files URLForDirectory:NSApplicationSupportDirectory inDomain:NSUserDomainMask
+                           appropriateForURL:nil create:YES error:NULL];
+        NSURL *documents = [files URLForDirectory:NSDocumentDirectory inDomain:NSUserDomainMask
+                             appropriateForURL:nil create:YES error:NULL];
+        if (!support || !documents) return 1;
+
+        NSString *exe = [support.path stringByAppendingPathComponent:@"DownhillRevived"];
+        if (![exe getFileSystemRepresentation:writable_executable_path maxLength:sizeof writable_executable_path])
+            return 1;
+        NSString *disc = [documents.path stringByAppendingPathComponent:@"SCUS-97177.iso"];
+        NSString *settings = [support.path stringByAppendingPathComponent:@"dhd.ini"];
+        SDL_SetHint(SDL_HINT_ORIENTATIONS, "LandscapeLeft LandscapeRight");
+        SDL_SetHint(SDL_HINT_IOS_HIDE_HOME_INDICATOR, "2");
+        if (![files fileExistsAtPath:disc]) {
+            NSString *guide = [documents.path stringByAppendingPathComponent:@"Put SCUS-97177.iso Here.txt"];
+            [@"Copy your original Downhill Domination USA ISO here as SCUS-97177.iso."
+                 writeToFile:guide atomically:YES encoding:NSUTF8StringEncoding error:NULL];
+        }
+        if (!wait_for_disc(disc)) return 1;
+        if (!dhd_settings_save(settings.fileSystemRepresentation, "iso", disc.fileSystemRepresentation)) return 1;
+        setenv("TMPDIR", NSTemporaryDirectory().fileSystemRepresentation, 1);
+        setenv("DHD_LAUNCHER", "1", 1);
+        setenv("DHD_SETTINGS", settings.fileSystemRepresentation, 1);
+        setenv("DHD_DATA_DIR", support.fileSystemRepresentation, 1);
+        setenv("DHD_MEMCARD_DIR", support.fileSystemRepresentation, 1);
+        return dhd_launcher_main(argc, argv);
+    }
+}
