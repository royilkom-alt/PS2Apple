diff --git a/port/ios/touch_bridge.c b/port/ios/touch_bridge.c
new file mode 100644
--- /dev/null
+++ b/port/ios/touch_bridge.c
@@ -0,0 +1,48 @@
+/* Map the shared UIKit overlay to Downhill's native player-one pad. GPL-3.0-or-later. */
+#include "launcher.h"
+#include "shared/PS2AppleUI.h"
+#include "../hle/hle.h"
+#include "../host/host_api.h"
+
+/* The game supplies a zero-initialized field. UIKit provides the pad separately. */
+void host_service_touch_field(uint32_t address) { (void)address; }
+
+int touch_host_event(const SDL_Event *event) { (void)event; return 0; }
+
+void touch_host_tick(void)
+{
+    SDL_JoystickID selected = dhd_ios_selected_gamepad();
+    PS2SetGamepadConnected(selected ? SDL_IsGamepad(selected) : SDL_HasGamepad());
+}
+
+static uint8_t axis_byte(float value)
+{
+    return (uint8_t)((value + 1.0f) * 127.5f + 0.5f);
+}
+
+void touch_host_merge(HostPad *out)
+{
+    PS2TouchPad touch = PS2ReadTouchPad();
+    if (!touch.enabled) return;
+    static const uint16_t pressure_order[12] = {
+        PAD_RIGHT, PAD_LEFT, PAD_UP, PAD_DOWN, PAD_TRIANGLE, PAD_CIRCLE,
+        PAD_CROSS, PAD_SQUARE, PAD_L1, PAD_R1, PAD_L2, PAD_R2
+    };
+    out->buttons |= touch.buttons;
+    for (int i = 0; i < 12; ++i)
+        if (touch.buttons & pressure_order[i]) out->pressure[i] = 255;
+    if (touch.active[0]) {
+        out->left_x = axis_byte(touch.x[0]);
+        out->left_y = axis_byte(touch.y[0]);
+    }
+    if (touch.active[1]) {
+        out->right_x = axis_byte(touch.x[1]);
+        out->right_y = axis_byte(touch.y[1]);
+    }
+}
+
+int touch_host_overlay(float *items, int max, float *width, float *height)
+{
+    (void)items; (void)max; (void)width; (void)height;
+    return 0;  /* UIKit is the only iOS controller overlay. */
+}
