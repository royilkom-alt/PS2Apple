+def require_compiled(result):
+    if result['status'] == 'ok':
+        return
+    line, error = result['errors'][0] if result['errors'] else (0, '')
+    location = '%s:%d' % (result['unit'], line) if line else result['unit']
+    sys.exit('%s (%s): %s' % (location, result['stage'], error or 'compiler returned an error'))
+
+
+def build_units(executor, worker, jobs, *, fail_fast, check=None):
+    """Keep results in job order, but report the first completed error in fail-fast mode."""
+    if not fail_fast:
+        return list(executor.map(worker, jobs))
+    pending = {executor.submit(worker, job): i for i, job in enumerate(jobs)}
+    results = [None] * len(pending)
+    try:
+        for future in as_completed(pending):
+            result = future.result()
+            if check is not None:
+                check(result)
+            results[pending[future]] = result
+    except BaseException:
+        # Let active compilers finish writing their outputs. Drop work that has not started.
+        for future in pending:
+            future.cancel()
+        raise
+    return results
+
