+std::optional<PresentationFrame> GS::tryHostPresentationFrame(std::mutex &displayMutex, uint64_t &capturedTick,
+                                                              bool useContextFallback, bool weave)
+{
+    GSPresentationRequest request;
+    thread_local std::vector<uint8_t> snapshot;
+    {
+        // Skip a busy GS. The host can present the last complete image and poll input on time.
+        std::unique_lock<std::recursive_mutex> stateLock(m_stateMutex, std::try_to_lock);
+        if (!stateLock || !m_backend || !m_privRegs)
+            return std::nullopt;
+        std::unique_lock<std::mutex> displayLock(displayMutex, std::try_to_lock);
+        if (!displayLock)
+            return std::nullopt;
+        request = buildPresentationRequestUnlocked();
+        if (request.pmode & 3u)
+        {
+            std::unique_lock<std::mutex> backendLock(m_backendLifetimeMutex, std::try_to_lock);
+            if (!backendLock)
+                return std::nullopt;
+            // Copy VRAM while the display registers and draw context belong to the same snapshot.
+            m_backend->SnapshotVram(snapshot);
+        }
+        capturedTick = request.vsyncTick;
+    }
+    if (!(request.pmode & 3u))
+    {
+        std::lock_guard<std::mutex> presentationLock(m_presentationMutex);
+        m_fieldWeaver.reset();
+        return PresentationFrame{}; // Both display outputs are explicitly disabled.
+    }
+
+    // The tick already denotes the active field. Scan out the completed one.
+    if (request.vsyncTick) --request.vsyncTick;
+    request.useContextFallback = useContextFallback;
+    request.interpolateFields = !weave;
+    PresentationFrame frame = GSCpuBackend::PresentSnapshot(request, snapshot);
+    if (!frame)
+        return std::nullopt;
+    if (weave)
+    {
+        std::lock_guard<std::mutex> presentationLock(m_presentationMutex);
+        m_fieldWeaver.apply(frame, request);
+    }
+    return frame;
+}
