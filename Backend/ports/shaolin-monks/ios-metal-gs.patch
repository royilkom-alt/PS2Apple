+bool GS::tryHostMetalPresent(std::mutex &displayMutex, uint64_t &capturedTick, bool show)
+{
+    std::unique_lock<std::recursive_mutex> stateLock(m_stateMutex, std::try_to_lock);
+    if (!stateLock || !m_backend || !m_privRegs)
+        return false;
+    std::unique_lock<std::mutex> displayLock(displayMutex, std::try_to_lock);
+    if (!displayLock)
+        return false;
+    const auto request = buildPresentationRequestUnlocked();
+    capturedTick = request.vsyncTick;
+    displayLock.unlock();
+    return m_backend->PresentToWindow(request, show);
+}
